# Copiá este archivo como ".env" para probar localmente (no se sube a git).
# En Render, estas mismas variables se configuran en el panel del servicio
# (Environment), no en un archivo.

# Clave para entrar al panel de administración. OBLIGATORIA.
ADMIN_PASSWORD=cambiame-por-una-clave-segura

# Opcional. Si la definís, los datos se guardan en Postgres (recomendado:
# no se pierden ni con redeploys ni con reinicios). Si la dejás vacía, los
# datos se guardan en un archivo local (data/site-data.json).
DATABASE_URL=

# Puerto local (Render define el suyo automáticamente, no hace falta tocarlo ahí).
PORT=3000
